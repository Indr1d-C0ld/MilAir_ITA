# ---------------------------------------------------------------------------
# Esempio di .htaccess per MilAir ITA — copiare in ".htaccess" nella web root.
#
# Questo file è il modello pubblico: contiene la configurazione consigliata,
# senza riferimenti a uno specifico deployment. Il .htaccess realmente in uso
# non è versionato qui (vedi la sezione "Installazione" del README).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Header di sicurezza
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Impedisce al browser di "indovinare" un tipo diverso da quello dichiarato
    # (es. interpretare come HTML un .jpg caricato dagli utenti).
    Header always set X-Content-Type-Options "nosniff"

    # Anti-clickjacking: la pagina non può essere incorniciata da altri siti.
    # X-Frame-Options per i browser vecchi, frame-ancestors per quelli moderni.
    Header always set X-Frame-Options "SAMEORIGIN"

    # Non far trapelare l'URL completo (con i filtri di ricerca) verso siti terzi
    # raggiunti dai link esterni della tabella (FlightRadar24, JetPhotos, ecc.).
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Il vhost serve solo HTTPS: impone al browser di non riprovare in chiaro.
    # Senza includeSubDomains né preload, per non vincolare altri host del dominio.
    Header always set Strict-Transport-Security "max-age=15552000"

    # Niente API del browser che questa applicazione non usa.
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

    # CSP volutamente limitata a frame-ancestors: l'applicazione usa script e
    # stili inline in quasi tutte le pagine (convenzione del progetto), quindi
    # una default-src restrittiva richiederebbe 'unsafe-inline' — che ne
    # annullerebbe il beneficio principale. Una CSP piena avrebbe senso solo
    # dopo aver spostato gli inline in file separati: lavoro ampio, non fatto qui.
    #
    # Se l'applicazione va incorporata in un iframe da un'altra origine (per
    # esempio una dashboard servita su un'altra porta dello stesso host),
    # aggiungere quell'origine qui e rimuovere X-Frame-Options sopra
    # (sostituendolo con "Header always unset X-Frame-Options"): quell'header
    # accetta una sola origine e SAMEORIGIN confronta anche la porta, quindi
    # non sa esprimere l'eccezione e bloccherebbe comunque il frame.
    Header always set Content-Security-Policy "frame-ancestors 'self'"
</IfModule>

# Nega l'accesso diretto ai file contenenti le API key (mai serviti al browser,
# usati solo lato server via require_once)
<FilesMatch "^(map_secrets|geo_secrets|ai_secrets)\.php$">
    Require all denied
</FilesMatch>

# Nega l'accesso all'intera cartella cache/ (tile satellite/meteo cache lato
# server, mai acceduta direttamente dal browser: si passa sempre per i proxy
# satellite_tile.php/weather_tile.php)
RewriteEngine On
RewriteRule ^cache/ - [F,L]

# Nega l'accesso diretto a dati grezzi/export/backup nel web root (usati solo
# da script server-side o Python, oppure generati come download dinamico con
# Content-Disposition — mai pensati per essere serviti come file statici)
<FilesMatch "\.(json|csv|bak)$">
    Require all denied
</FilesMatch>

# Nega l'accesso diretto ai database SQLite (auth.db/events.db/news.db e i loro
# eventuali file collaterali .db-shm/.db-wal) — contengono dati sensibili
# (hash delle password inclusi) e vanno acceduti solo lato server via PHP.
<FilesMatch "\.db(-shm|-wal|-journal)?$">
    Require all denied
</FilesMatch>

# Nega l'accesso diretto a log applicativi, script server-side e file di
# servizio lasciati nella web root dai cron (alerts.log, crontab.txt,
# csv_to_db.py, flight_mil_ita.py, milair-logger.service, fix_permissions.sh,
# index.php_old, rules.php_old, ecc.): erano scaricabili da chiunque, nessuna
# pagina dell'app li richiama via browser.
<FilesMatch "\.(log|py|sh|service)$">
    Require all denied
</FilesMatch>
<FilesMatch "_old$">
    Require all denied
</FilesMatch>

# Librerie di sole funzioni, incluse da altri script e mai richieste dal browser.
# Oggi restituiscono una pagina vuota (non producono output), quindi non c'è una
# fuga di dati: negarle è difesa in profondità, perché un errore futuro in una di
# esse potrebbe altrimenti diventare visibile all'esterno.
<FilesMatch "^(auth|geo_lib|diary_lib|news_lib|ai_lib|table_lib)\.php$">
    Require all denied
</FilesMatch>
<Files "crontab.txt">
    Require all denied
</Files>
