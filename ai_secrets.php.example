<?php
// Credenziali/parametri per l'assistente IA opzionale del Diario (sintesi
// narrativa generata da un modello LLM in esecuzione su un server Ollama
// nella propria rete locale — non un servizio cloud).
// Usato SOLO server-side da ai_lib.php: la chiamata parte sempre dal
// server, mai dal browser, e l'indirizzo non deve mai comparire in
// HTML/JS inviato al client.
//
// Copia questo file in "ai_secrets.php" e inserisci il tuo endpoint.
// Tutte le chiavi sono opzionali: se AI_BASE_URL è vuoto, la sezione
// "Genera sintesi IA" nel Diario resta semplicemente nascosta, il resto
// dell'app (digest deterministico, pubblicazione) funziona regolarmente.
//
// - AI_BASE_URL: indirizzo del server Ollama (es. 'http://192.168.1.50:11434')
//   https://ollama.com — installazione locale, nessun account/chiave richiesti
// - AI_MODEL:    nome di un modello già scaricato su quel server (es. 'ollama pull qwen2.5:14b')
// - AI_NUM_CTX:  finestra di contesto richiesta al modello
// - AI_TIMEOUT_S: attesa massima della risposta (i modelli locali sono lenti)
// - AI_MIN_ROLE: ruolo minimo che può generare la sintesi ('admin' o 'collaboratore')
define('AI_BASE_URL', '');
define('AI_MODEL', 'qwen2.5:14b');
define('AI_NUM_CTX', 16384);
define('AI_TIMEOUT_S', 600);
define('AI_MIN_ROLE', 'admin');
